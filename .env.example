APP_NAME=event-pipeline
SERVER_PORT=8080
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=event_pipeline
# Supply credentials locally; there are deliberately no credential defaults.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_USERNAME=
MONGO_PASSWORD=
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localstack:4566
AWS_SQS_QUEUE_NAME=event-pipeline-events
AWS_SQS_DLQ_NAME=event-pipeline-events-dlq
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Consumer (processing side). Values below are the application defaults; uncomment to override.
# AWS_SQS_CONSUMER_ENABLED=true
# AWS_SQS_CONSUMER_MAX_MESSAGES=10
# AWS_SQS_CONSUMER_WAIT_TIME_SECONDS=20
# AWS_SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
# AWS_SQS_CONSUMER_WORKER_THREADS=4
# AWS_SQS_CONSUMER_SHUTDOWN_WAIT_SECONDS=25

# MUST equal the main queue redrive maxReceiveCount (the init script uses this same value).
PROCESSING_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=5
RETRY_BACKOFF_CAP_SECONDS=60
RELAY_ENABLED=true
RELAY_INTERVAL_SECONDS=10
RELAY_STALE_RECEIVED_THRESHOLD_SECONDS=60
RELAY_BATCH_SIZE=100
RECOVERY_ENABLED=true
RECOVERY_INTERVAL_SECONDS=10
# MUST exceed visibility timeout and maximum expected processing time.
RECOVERY_STALE_PROCESSING_THRESHOLD_SECONDS=300

